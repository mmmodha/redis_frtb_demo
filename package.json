{
  "name": "frtb-sbm-redis-pov",
  "version": "0.1.0",
  "private": true,
  "description": "HSBC FRTB-SA SBM PoV on Redis Enterprise — sales vehicle demo",
  "workspaces": [
    "services/*",
    "shared/*",
    "tools/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "schema:generate": "npm run -w @frtb/schema-cli generate -- ../../config/schema/frtb-default.yaml --out ../../shared/schema/generated",
    "schema:validate": "npm run -w @frtb/schema-cli validate -- ../../config/schema/frtb-default.yaml"
  },
  "devDependencies": {
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
