{
  "name": "frtb-sbm-redis-pov",
  "version": "0.1.0",
  "private": true,
  "description": "Tier-1 bank FRTB-SA SBM PoV on Redis Enterprise — sales vehicle demo",
  "workspaces": [
    "services/*",
    "shared/*",
    "tools/*"
  ],
  "scripts": {
    "start": "scripts/docker-up.sh",
    "docker:up": "scripts/docker-up.sh",
    "docker:up:dev": "scripts/docker-up.sh --dev",
    "docker:up:400m": "scripts/docker-up.sh --scale 400m --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "schema:generate": "npm run -w @frtb/schema-cli generate -- ../../config/schema/frtb-default.yaml --out ../../shared/schema/generated",
    "schema:validate": "npm run -w @frtb/schema-cli validate -- ../../config/schema/frtb-default.yaml",
    "asset-pack": "node tools/asset-pack/src/cli.mjs",
    "test:e2e:live": "INTEGRATION=1 playwright test --config e2e/playwright.config.ts e2e/full-demo.spec.ts"
  },
  "devDependencies": {
    "@types/seedrandom": "^3.0.8",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
