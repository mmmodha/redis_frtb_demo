# FRTB SBM PoV — environment variable template.
#
# ## Optional — all values have safe defaults. The primary way to configure
# ## Redis is via the UI Connections panel at
# ## http://localhost:3000/connections.
#
# `scripts/run-local.sh start` auto-creates a minimal `.env.local` with
# generated CONN_STORE_KEY + INTERNAL_API_TOKEN secrets on first run; you do
# not need to copy this template by hand. Copy/uncomment entries from this
# file into `.env.local` only when you want to override a default.
#
# `.env.local` is gitignored — DO NOT COMMIT REAL CREDENTIALS.
#
# docker-compose.yml reads these vars at `docker compose up` (via `env_file:
# .env.local` with `required: false`) and propagates them to every Redis-
# touching service (api, source, ingest, generator, calc, loadgen).

# -----------------------------------------------------------------------------
# Optional pre-seed: Redis connection
# -----------------------------------------------------------------------------
#
# Leave REDIS_URL unset to configure Redis through the UI Connections panel
# (the recommended path). Setting it here pre-seeds a clickable Connection
# profile in the UI on boot, named `live-standalone` (default) or
# `live-cluster` when REDIS_CLUSTER=true — useful for repeatable demo / CI
# environments.

# Full Redis URL. Format: redis://[username][:password]@host:port[/db]
# Use `rediss://` for TLS or set REDIS_TLS=true below.
# For Redis Enterprise cluster pointed at the seed/proxy endpoint:
#   redis://:YOUR_PASSWORD@your-cluster-host.example.com:10395
#
# Wave 5.80 — the `generator` one-shot tool (opt-in; NOT launched by
# `scripts/run-local.sh start`) pushes synthetic rows into a Redis Stream
# at this URL. Stream key defaults to `sensitivities:in`; override with the
# STREAM_KEY env var or `--stream <key>` on the generator CLI. Invoke with
# `scripts/run-local.sh start generator -- --rows 1000` for a small run.
# REDIS_URL=redis://:CHANGE_ME@localhost:6379

# TLS toggle. Inferred from the URL scheme (rediss:// → true) when unset;
# set explicitly to override for either direction.
REDIS_TLS=false

# Cluster-mode toggle. Wave 6.39.E — default is FALSE (Enterprise-first):
# Redis Enterprise presents a single proxy endpoint that hides the sharded
# topology and blocks `CLUSTER SLOTS` discovery, so ioredis must connect as
# standalone. Set to true ONLY for OSS Redis Cluster targets that expose
# CLUSTER commands on the seed endpoint.
# REDIS_CLUSTER=false

# Bump for high-latency Redis Cloud endpoints (cross-internet handshakes).
# Default 5000 is fine for local docker-compose Redis.
# REDIS_READY_TIMEOUT_MS=30000

# Wave 6.33 Phase 0 — named placeholders for the cloud Redis cluster target.
# These are documentation only; the live values live in `.env.local` (gitignored)
# and are never committed. Leave blank in this template.
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=
# REDIS_TLS=

# -----------------------------------------------------------------------------
# Application secrets (auto-generated by scripts/run-local.sh on first run)
# -----------------------------------------------------------------------------
#
# `scripts/run-local.sh start` writes a fresh `CONN_STORE_KEY` (32-byte hex)
# and `INTERNAL_API_TOKEN` (16-byte hex) into `.env.local` when the file does
# not yet exist. Override the values below only if you're managing `.env.local`
# by hand (e.g. CI / shared dev box). Leaving CONN_STORE_KEY at the literal
# `dev-only-change-in-prod` triggers a `doctor` warning.

# 32-byte hex key used by the api's encrypted Connections store.
# Generate with: `openssl rand -hex 32`
CONN_STORE_KEY=dev-only-change-in-prod

# Wave 5.16u — static bearer the api requires on its internal full-credential
# endpoint (/internal/redis/active-target/full). source and loadgen send this
# in the Authorization header so they can follow profile switches without
# re-encoding the connection store. Override in .env.local for any reachable
# demo; the dev default is only safe on a private docker network.
INTERNAL_API_TOKEN=dev-internal-token

# Optional log verbosity for all services. One of: trace|debug|info|warn|error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Optional — calc path selectors (api service)
# -----------------------------------------------------------------------------
#
# The /calc/sbm route picks one of three per-bucket K_b execution paths:
#   • rollup        — HGETALL pre-aggregated `rollup:{rc:bkt}:*` hashes.
#   • ft_aggregate  — single FT.AGGREGATE over `idx:sens:v*` (fast path).
#   • fcall_lua     — legacy per-bucket Lua FCALL (slot-local SCAN). LEGACY
#                     after Wave 6.31 — the kernels require the pre-6.31
#                     sens-key hash-tag shape and find nothing on the
#                     current schema.
#
# Defaults: rollup ON, ft_aggregate ON, fcall_lua OFF.

# Set CALC_FAST_PATH=0 to disable the FT.AGGREGATE fast path. The route
# will fall through to the rollup path (if enabled) or the legacy FCALL
# fallback (if enabled). Default: enabled.
# CALC_FAST_PATH=1

# Set CALC_ROLLUP_PATH=0 to disable the rollup fast-fast path (HGETALL
# pre-aggregated bucket hashes). Default: enabled.
# CALC_ROLLUP_PATH=1

# Wave 6.31.C — re-enable the legacy Lua FCALL fallback. Default OFF:
# after Wave 6.31.A removed the sens-key hash-tag, the FCALL kernels'
# slot-local SCAN no longer locates any docs. Set to "1" only if you
# have also restored the pre-Wave-6.31 sens-key shape (see
# services/calc/lib/girr_*.lua header).
# CALC_FCALL_FALLBACK=0

# -----------------------------------------------------------------------------
# Wave 5.16g — api CORS allow-list (browser → api)
# -----------------------------------------------------------------------------

# Comma-separated list of origins the api allows for cross-origin requests.
# The demo ui is served by nginx on http://localhost:3000 and fetches the
# api at http://localhost:8080, so the default is the ui's host-mapped
# origin. Set to "*" for permissive local dev (any origin echoed back).
# The api uses no cookies, so credentialed CORS is intentionally NOT
# enabled — clients should not send credentials: 'include'.
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Wave 5.78 — local-developer launcher overrides (optional)
# -----------------------------------------------------------------------------
#
# `scripts/run-local.sh` boots services outside Docker. Their defaults are
# computed relative to the repo root, so a fresh laptop needs nothing in
# `.env.local` at all — the launcher auto-creates the file with generated
# secrets and lets the UI Connections panel configure Redis. Override any of
# these only if the defaults don't suit your environment:
#
#   SCHEMA_FILE       — defaults to <repo>/config/schema/frtb-default.yaml
#   CONN_STORE_FILE   — defaults to <repo>/.run/data/connections.enc.json (api)
#   UPLOAD_DIR        — defaults to <repo>/.run/data/uploads (source)
#
# Under `docker compose up` the Dockerfile/compose env vars override these,
# so Docker behavior is unchanged.

# -----------------------------------------------------------------------------
# Wave 5.79 — full endpoint configurability (multi-VM ready)
# -----------------------------------------------------------------------------
#
# Each service binds host+port from env with the precedence:
#   <SVC>_HOST / <SVC>_PORT → HOST / PORT → HEALTH_PORT → hardcoded default.
# Each cross-service URL has the precedence:
#   <TARGET>_BASE → http://localhost:${<TARGET>_PORT ?? <default>}.
#
# Default boot needs none of these; uncomment + set only what differs from
# the defaults below. Under `docker compose up` the compose `environment:`
# block sets the docker-network equivalents and overrides these.

# === Service binding (where each service listens) ===
# Override to remap ports or restrict to localhost only.
# API_HOST=0.0.0.0
# API_PORT=8080
# SOURCE_HOST=0.0.0.0
# SOURCE_PORT=8082
# INGEST_HOST=0.0.0.0
# INGEST_PORT=8083
# CALC_HOST=0.0.0.0
# CALC_PORT=8084
# LOADGEN_HOST=0.0.0.0
# LOADGEN_PORT=8085
# GENERATOR_PORT=8081
# UI_HOST=0.0.0.0
# UI_PORT=3000

# === Cross-service URLs (where consumers find each service) ===
# Override for multi-VM deployments. Defaults compute as http://localhost:<port>.
# API_BASE=http://localhost:8080
# SOURCE_BASE=http://localhost:8082
# INGEST_BASE=http://localhost:8083
# CALC_BASE=http://localhost:8084
# LOADGEN_BASE=http://localhost:8085

# === UI → API routing (browser) ===
# Default: UI server reverse-proxies "/api/*" → http://localhost:8080 (single-VM friendly).
# Override only if the UI bundle must talk directly to a remote API host:
# VITE_API_BASE=http://api.example.com:8080
#
# Inside the UI server, override the proxy target if the API isn't on 127.0.0.1:8080:
# UI_API_PROXY_HOST=127.0.0.1
# UI_API_PROXY_PORT=8080
