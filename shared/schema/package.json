{
  "name": "@frtb/schema",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "schema:generate": "pnpm --filter @frtb/schema-cli exec tsx src/bin.ts generate ../../config/schema/frtb-default.yaml --out ../../shared/schema/generated",
    "schema:validate": "pnpm --filter @frtb/schema-cli exec tsx src/bin.ts validate"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
